<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MQTT Web Client - ESP32</title>
    <!-- Memuat library Paho MQTT dari CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/paho-mqtt/1.0.1/mqttws31.min.js" type="text/javascript"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            background-color: #f9f9f9;
        }
        .container {
            position: relative;
            background: #fff;
            border: 1px solid #ccc;
            padding: 20px;
            width: 320px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            border-radius: 4px;
        }
        .status-indicator {
            width: 12px;
            height: 12px;
            background-color: red;
            border-radius: 50%;
            display: inline-block;
            margin-bottom: 10px;
        }
        .status-indicator.connected {
            background-color: green;
        }
        .settings-btn {
            position: absolute;
            top: 20px;
            right: 20px;
            background: none;
            border: 1px solid #ccc;
            cursor: pointer;
            padding: 5px 8px;
            border-radius: 4px;
        }
        .config-box {
            margin-top: 15px;
            border-top: 1px solid #ddd;
            padding-top: 15px;
        }
        .form-group {
            margin-bottom: 10px;
        }
        .form-group label {
            display: block;
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 3px;
        }
        .form-group input, .form-group select {
            width: 100%;
            padding: 6px;
            box-sizing: border-box;
            border: 1px solid #ccc;
            border-radius: 3px;
        }
        .btn-connect {
            width: 100%;
            padding: 8px;
            background-color: #f1f1f1;
            border: 1px solid #ccc;
            cursor: pointer;
            font-weight: bold;
            border-radius: 3px;
            margin-top: 5px;
        }
        .btn-connect:hover {
            background-color: #e2e2e2;
        }
        .section-box {
            margin-top: 15px;
            background: #f1f1f1;
            padding: 8px;
            font-weight: bold;
            border: 1px solid #ccc;
            border-radius: 3px;
        }
        .content-box {
            margin-top: 20px;
            border: 1px solid #ccc;
            padding: 15px;
            background: #fff;
            min-height: 80px;
            border-radius: 4px;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Indikator Koneksi -->
        <div id="statusIndicator" class="status-indicator"></div>
        
        <!-- Tombol Pengaturan (Ikon Gigi) -->
        <button class="settings-btn" onclick="toggleConfig()">⚙️</button>

        <!-- Area Konten Utama -->
        <div class="content-box">
            <h3>Subscribed Data from ESP32:</h3>
            <p id="messages">Belum ada data...</p>
        </div>

        <!-- Panel Konfigurasi Broker MQTT -->
        <div id="configBox" class="config-box">
            <h4>Broker Config</h4>
            <div class="form-group">
                <label>Protocol:</label>
                <select id="protocol">
                    <option value="wss" selected>wss</option>
                    <option value="ws">ws</option>
                </select>
            </div>
            <div class="form-group">
                <label>Broker:</label>
                <input type="text" id="broker" value="broker.emqx.io">
            </div>
            <div class="form-group">
                <label>Port:</label>
                <input type="number" id="port" value="8084">
            </div>
            <div class="form-group">
                <label>Path:</label>
                <input type="text" id="path" value="/mqtt">
            </div>
            <button class="btn-connect" onclick="MQTTconnect()">Connect</button>
        </div>

        <!-- Panel Tambahan (Subscribe & Publish) -->
        <div class="section-box">Subscribe</div>
        <div class="section-box">Publish</div>
    </div>

    <script>
        let client = null;

        function toggleConfig() {
            const box = document.getElementById('configBox');
            box.style.display = box.style.display === 'none' ? 'block' : 'none';
        }

        function MQTTconnect() {
            let protocol = document.getElementById('protocol').value;
            let broker = document.getElementById('broker').value;
            let port = parseInt(document.getElementById('port').value);
            let path = document.getElementById('path').value;
            
            // Membuat Client ID unik
            let clientId = "web_client_" + Math.random().toString(16).substr(2, 8);

            console.log(`Menghubungkan ke ${broker}:${port}${path} menggunakan ${protocol}`);

            // Inisialisasi Paho MQTT Client
            client = new Paho.MQTT.Client(broker, port, path, clientId);

            // Handler ketika koneksi hilang
            client.onConnectionLost = function (responseObject) {
                if (responseObject.errorCode !== 0) {
                    console.log("Koneksi terputus: " + responseObject.errorMessage);
                }
                document.getElementById("statusIndicator").classList.remove("connected");
            };

            // Handler ketika pesan tiba
            client.onMessageArrived = function (message) {
                console.log("Pesan diterima: " + message.payloadString);
                document.getElementById("messages").innerHTML = "<b>Topik:</b> " + message.destinationName + "<br><b>Pesan:</b> " + message.payloadString;
            };

            // Opsi koneksi (menggunakan SSL/TLS karena WSS)
            let options = {
                timeout: 3,
                useSSL: protocol === "wss",
                onSuccess: onConnect,
                onFailure: onFailure
            };

            client.connect(options);
        }

        function onConnect() {
            console.log("Berhasil terhubung ke broker MQTT!");
            document.getElementById("statusIndicator").classList.add("connected");
            
            // Melakukan Subscribe ke topik tertentu (sesuaikan dengan topik ESP32 Anda)
            let topic = "esp32/sensor"; 
            client.subscribe(topic);
            alert("Berhasil terhubung dan subscribe ke topik: " + topic);
        }

        function onFailure(message) {
            console.log("Koneksi gagal: " + message.errorMessage);
            alert("Gagal terhubung ke broker: " + message.errorMessage);
            document.getElementById("statusIndicator").classList.remove("connected");
        }
    </script>
</body>
</html>
